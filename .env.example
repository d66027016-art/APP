# Finance by Pooja - Environment Configuration Example

# Server Settings
PORT=3000
HOST=localhost

# Application Branding
VITE_APP_NAME="Finance by Pooja"
VITE_APP_SHORT_NAME="Pooja Finance"

# Default Preferences
VITE_DEFAULT_CURRENCY="₹"
VITE_DEFAULT_INTEREST_TYPE="monthly"
VITE_THEME="light"

# Database Configuration
VITE_DB_NAME="UdhaarManagerDB"
VITE_DB_VERSION=1

# Feature Flags
VITE_ENABLE_NOTIFICATIONS=true
VITE_SYSTEM_DATE="2026-08-19"
